AI_WORKSHOP_ENVIRONMENT=local
AI_WORKSHOP_SECRET_KEY=replace-with-at-least-32-random-characters
AI_WORKSHOP_DATABASE_URL=postgresql+psycopg://ai_workshop:ai_workshop@127.0.0.1:5432/ai_workshop
AI_WORKSHOP_REDIS_URL=redis://127.0.0.1:6379/0
AI_WORKSHOP_OBJECT_STORE_ROOT=.local-data/objects
AI_WORKSHOP_ELASTICSEARCH_URL=http://127.0.0.1:9200
AI_WORKSHOP_ELASTICSEARCH_INDEX_PREFIX=ai-workshop-rag
# 새 RAG build는 두 binding 값이 필요하다. 활성화 절차는 docs/runbooks/local-development.md 참조.
# AI_WORKSHOP_RAG_INDEX_STORE_ID=rag_indexes
# AI_WORKSHOP_RAG_INDEX_CLUSTER_UUID=<실제 Elasticsearch cluster_uuid>
AI_WORKSHOP_MODEL_CACHE_ROOT=.local-data/models
# Deployment API가 허용할 endpoint reference와 실제 URL의 JSON map이다.
# AI_WORKSHOP_PROVIDER_ENDPOINT_REFS={"openai-responses":"https://api.openai.com"}
# 실제 secret은 Git에 포함하지 않고 배포 환경에서만 JSON map으로 설정한다.
# AI_WORKSHOP_PROVIDER_SECRET_REFS={"openai-primary":"replace-in-local-environment"}
# 로컬 OpenAI-compatible 런타임을 설치한 뒤에만 설정한다. 외부 URL은 거부된다.
# AI_WORKSHOP_GENERATION_BASE_URL=http://127.0.0.1:11434
# 인증이 필요한 로컬 런타임에서만 실제 비밀값을 Git에 포함되지 않는 로컬 .env에 둔다.
# AI_WORKSHOP_GENERATION_API_KEY=
API_PORT=8000
# 통합 로컬 frontend만 루트 .env를 사용한다. 공개 전용 frontend는 프로세스 환경으로 설정한다.
AI_WORKSHOP_FRONTEND_RUNTIME=combined
PUBLIC_API_PORT=18001
# 필요 시 공개 reader origin을 명시한다(비밀값·인증정보 없이 origin만).
# AI_WORKSHOP_PUBLIC_API_TARGET=http://127.0.0.1:18001
# private API의 공개 게시본 저장 경로. 다른 작업 디렉터리로 실행하면 절대 경로를 사용한다.
AI_WORKSHOP_PUBLISHING_PUBLIC_STORE_PATH=.local-data/public/studies.sqlite3
AI_WORKSHOP_PUBLISHING_DELIVERY_MODE=local
# 운영은 manual 모드를 요구하며 실제 반출·반입·receipt 운영 준비가 별도로 필요하다.
# 공개 reader에 이 .env 전체를 전달하지 않는다. AI_WORKSHOP_PUBLIC_STORE_PATH만 별도 지정한다.
POSTGRES_DB=ai_workshop
POSTGRES_USER=ai_workshop
POSTGRES_PASSWORD=ai_workshop
POSTGRES_PORT=5432
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
