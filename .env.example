AI_WORKSHOP_ENVIRONMENT=local
AI_WORKSHOP_SECRET_KEY=replace-with-at-least-32-random-characters
AI_WORKSHOP_DATABASE_URL=postgresql+psycopg://ai_workshop:ai_workshop@127.0.0.1:5432/ai_workshop
AI_WORKSHOP_REDIS_URL=redis://127.0.0.1:6379/0
AI_WORKSHOP_OBJECT_STORE_ROOT=.local-data/objects
AI_WORKSHOP_ELASTICSEARCH_URL=http://127.0.0.1:9200
AI_WORKSHOP_ELASTICSEARCH_INDEX_PREFIX=ai-workshop-rag
AI_WORKSHOP_MODEL_CACHE_ROOT=.local-data/models
# 로컬 OpenAI-compatible 런타임을 설치한 뒤에만 설정한다. 외부 URL은 거부된다.
# AI_WORKSHOP_GENERATION_BASE_URL=http://127.0.0.1:11434
# 인증이 필요한 로컬 런타임에서만 실제 비밀값을 Git에 포함되지 않는 로컬 .env에 둔다.
# AI_WORKSHOP_GENERATION_API_KEY=
API_PORT=8000
POSTGRES_DB=ai_workshop
POSTGRES_USER=ai_workshop
POSTGRES_PASSWORD=ai_workshop
POSTGRES_PORT=5432
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
